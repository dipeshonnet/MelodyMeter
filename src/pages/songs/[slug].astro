---
import Layout from '../../layouts/Layout.astro';
import SongDetail from '../../components/SongDetail.astro';
import { songs } from '../../lib/catalog';
import type { Song } from '../../../shared/rating';
import { songDescription, songSchema } from '../../lib/seo';
export function getStaticPaths() { return songs.map(song => ({ params: { slug: song.slug }, props: { song } })); }
interface Props { song: Song; }
const { song } = Astro.props;
---
<Layout title={`${song.title} — singing difficulty | MelodyMeter`} description={songDescription(song)} structuredData={songSchema(song, Astro.site)} markdownPath={`/songs/${song.slug}.md`}><SongDetail song={song} /></Layout>
