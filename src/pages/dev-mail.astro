---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Local test inbox | MelodyMeter" privatePage><section class="text-page"><p class="eyebrow">LOCAL DEVELOPMENT ONLY</p><h1>Test verification inbox</h1><p>No emails are sent in local development. Open a pending link below, review its scores, and confirm it to test the real voting flow.</p><div class="mail-list" id="mail-list"><p>Loading…</p></div><button class="secondary-button" id="refresh-mail" style="margin-top:20px">Refresh inbox</button></section><script>import { api, escapeHTML } from '../scripts/common'; async function load() { const target = document.querySelector<HTMLElement>('#mail-list')!; try { const data = await api<{messages:{url:string;title:string;artist:string;createdAt:number}[]}>('/api/dev/mail'); target.innerHTML = data.messages.length ? data.messages.map(message => `<div class="mail-item"><strong>${escapeHTML(message.title)}</strong><p>${escapeHTML(message.artist)}</p><a class="primary-button" href="${escapeHTML(message.url)}">Review & confirm rating</a></div>`).join('') : '<p>No pending messages yet. Submit a rating on a song page first.</p>'; } catch (error) { target.textContent = error instanceof Error ? error.message : 'Unavailable.'; } } document.querySelector('#refresh-mail')?.addEventListener('click', load); load();</script></Layout>
