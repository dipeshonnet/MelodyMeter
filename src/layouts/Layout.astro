---
import '../styles/global.css';
import { canonicalUrl, jsonLd, pageSchema, SITE_TITLE, SITE_DESCRIPTION } from '../lib/seo';
interface Props { title?: string; description?: string; privatePage?: boolean; structuredData?: unknown; markdownPath?: string; }
const { title = SITE_TITLE, description = SITE_DESCRIPTION, privatePage = false, structuredData, markdownPath } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = canonicalUrl(pathname, Astro.site);
const image = new URL('/social-card.png', canonical).href;
const schema = structuredData ?? pageSchema(pathname, title, description, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101b31" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content={privatePage ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MelodyMeter" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MelodyMeter — Find a song you can sing. Hindi and English songs, rated for singing ease." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="MelodyMeter — Find a song you can sing." />
    {!privatePage && <>
      <link rel="canonical" href={canonical} />
      <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
      <link rel="alternate" type="application/json" href="/catalog.json" title="Public song catalog and saved estimates" />
      {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} title="Song facts in plain text" />}
      <script type="application/ld+json" set:html={jsonLd(schema)} />
    </>}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="MelodyMeter home"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>Melody<span class="brand-accent">Meter</span></span></a>
        <nav aria-label="Main navigation">
          <a href="/" class:list={[pathname === '/' && 'current']}>Explore</a>
          <a href="/?saved=1">Saved songs <span class="saved-count" id="saved-count">0</span></a>
          <a href="/how-we-rate/" class:list={[pathname === '/how-we-rate/' && 'current']}>How we rate</a>
        </nav>
        <button class="install-button" id="install-app" hidden>Install app</button>
      </div>
    </header>
    <div id="connection-notice" class="connection-notice" role="status" hidden>You’re offline. Saved songs and estimates are available.</div>
    <main id="main"><slot /></main>
    <footer class="site-footer"><a class="brand-text" href="/">MelodyMeter</a><span>Your next song, within reach.</span><a href="/privacy/">Privacy</a><a href="/how-we-rate/">Rating guide</a><a id="local-mail-link" href="/dev-mail/" hidden>Local test inbox</a></footer>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
    <script>import '../scripts/common';</script>
  </body>
</html>
